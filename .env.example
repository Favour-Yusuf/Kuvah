# Copy to .env.local for development, and add the same keys in your
# hosting provider's environment settings for production. Never commit
# .env.local.

# Resend API key (Resend → API Keys). Server-only. Needs "Full access":
# a "Sending access" key can send the email but can't add the contact.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Sender. The domain must be verified in Resend (Resend → Domains).
EMAIL_FROM="Favour from Kuvah <favour@mail.example.com>"

# Where replies go ("reply to this email with your monthly total").
# Use an inbox you actually read.
EMAIL_REPLY_TO=favour@example.com

# The Google Sheets link ending in /copy, so each person gets their own copy.
ONBOARDING_CALCULATOR_COPY_URL=https://docs.google.com/spreadsheets/d/SHEET_ID/copy

# Optional: Resend segment for everyone who downloads a resource
# (Resend → Contacts → Segments), and the topic they opt in to
# (Resend → Contacts → Topics), e.g. "New videos".
RESEND_SEGMENT_ID=
RESEND_TOPIC_ID=

# Optional: the live site URL, used to show the logo in emails.
# Leave empty until the domain is live.
SITE_URL=
